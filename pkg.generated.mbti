pub enum MissingPolicy {
  SkipMissing
  PreserveMissing
  ReplaceWith(value~ : Double)
} derive(Eq, @debug.Debug)

pub(all) struct NumericRange {
  minimum : Double
  maximum : Double
} derive(Eq, @debug.Debug)

